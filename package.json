{
    "name": "n8n-nodes-v3-dummy",
    "version": "0.1.0",
    "description": "Dummy community node declaring n8nNodesApiVersion 3, for testing the n8n node API version guard",
    "license": "MIT",
    "homepage": "https://github.com/garritfra/n8n-nodes-v3-dummy",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Garrit Franke",
        "email": "garrit@slashdev.space"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/garritfra/n8n-nodes-v3-dummy.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 3,
        "strict": true,
        "credentials": [],
        "nodes": [
            "dist/nodes/V3Dummy/V3Dummy.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
